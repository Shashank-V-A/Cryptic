# Database
DATABASE_URL=postgresql://vda:vda_dev_password@localhost:5433/vda_ledger?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
NODE_ENV=development

# Session / Auth (generate strong random values for production)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false

# Encryption key for exchange API credentials (32-byte hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Price provider (optional in Phase 1)
PRICE_API_KEY=
PRICE_PROVIDER=coingecko

# CoinDCX — read-only credentials only (never request trade/withdraw)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Demo mode
DEMO_MODE=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://vda:vda_dev_password@localhost:5433/vda_ledger?schema=public

# Redis (price cache, BullMQ queues, import preview TTL)
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=debug

# Session / Auth (generate strong random values for production)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CSRF double-submit cookie (recommended true in production)
CSRF_ENABLED=false

# Encryption key for exchange API credentials (32-byte hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Price provider — coingecko (default) | mock | stub
# coingecko: set PRICE_API_KEY for Pro; free tier works without key at low volume
PRICE_API_KEY=
PRICE_PROVIDER=coingecko

# CoinDCX — read-only credentials only (never request trade/withdraw)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Report file storage — local (default) | s3
REPORT_STORAGE=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Demo mode
DEMO_MODE=true

# CORS
CORS_ORIGIN=http://localhost:5173
